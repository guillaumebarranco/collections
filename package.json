{
  "name": "webarranco-makya",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "check-badges": "ts-node --project tsconfig.scripts.json scripts/check-badges.ts",
    "localize-entity-covers": "node scripts/localize-entity-cover-urls.js",
    "localize-entity-covers:dry-run": "node scripts/localize-entity-cover-urls.js --dry-run",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "ts-node --project tsconfig.server.json server/server.ts",
    "server:dev": "nodemon",
    "server:prod": "export NODE_ENV=production && ts-node --project tsconfig.server.json server/server.ts"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.5",
    "@angular/cdk": "^20.0.5",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.5",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.4",
    "@angular/cli": "^20.0.4",
    "@angular/compiler-cli": "^20.0.0",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.11",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2"
  }
}
